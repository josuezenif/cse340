<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project_details.title %>
        </h2>

        <p>
            <strong>Short description: </strong>
            <%= project_details.description %>
        </p>

        <p>
            <strong>Project Date: </strong>
            <%- new Date(project_details.project_date).toLocaleDateString('en-CA', { year: 'numeric' , month: 'short' ,
                day: 'numeric' });%>
        </p>

        <p>
            <strong>Location: </strong>
            <%= project_details.project_location %>
        </p>

        <p>
            <strong>Organization: </strong>
            <a href="/organization/<%=project_details.organization_id%>">
                <%= project_details.name %>
            </a>
        </p>

        <p>
            <strong>Categories: </strong>
            <% categories.forEach(category=> { %>
                - <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
                <% }) %>

        </p>

        <% if(user && user.role_name==='admin' ){ %>
            <p><a href="/project/<%= project_details.project_id %>/assign-categories">Edit Categories</a></p>
            <p><a href="/edit-project/<%= project_details.project_id %>">Edit Project</a></p>
            <% } %>

                <% if (isLoggedIn){ %>
                    <% if (volunteering) { %>
                        <p>You are volunteering for this project!</p>
                        <p><a href="/remove-volunteer/<%= project_details.project_id %>">Remove me as volunteer</a>
                            😥
                        </p>

                        <% } else { %>
                            <a href="/volunteer/<%= project_details.project_id %>">Volunteer!</a>
                            <% } %>
                                <% } %>
    </main>

    <%- include('partials/footer') %>