<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <% users.forEach(user=> {%>
            <div class="users">
                <p><strong>Name: </strong>
                    <%= user.name %>

                </p>
                <p><strong>Email: </strong>
                    <%= user.email %>
                </p>
                <p><strong>Role: </strong>
                    <%= user.role_name %>
                </p>
            </div>
            <% }) %>
    </main>
    <%- include('partials/footer') %>